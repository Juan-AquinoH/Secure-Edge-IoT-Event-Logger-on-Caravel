{
  "//": "Design files",
  "VERILOG_FILES": [
    "dir::../../verilog/rtl/defines.v",
    "dir::../../verilog/rtl/user_project_wrapper.v",
    "dir::../../verilog/rtl/secure_top.v",
    "dir::../../verilog/rtl/secure_logger_controller.v",
    "dir::../../verilog/rtl/logger_wb_controller.v",
    "dir::../../verilog/rtl/aes_xor.v",
    "dir::../../verilog/rtl/crc8.v",
    "dir::../../verilog/rtl/re_ram_nvm.v",
    "dir::../../verilog/rtl/tmr_re_ram_nvm_wrapper.v",
    "dir::../../verilog/rtl/tmr_rdata_voter.v",
    "dir::../../verilog/rtl/fifo_buffer.v",
    "dir::../../verilog/rtl/encryptor.v",
    "dir::../../verilog/rtl/parity_checker.v",
    "dir::../../verilog/rtl/aes_sbox.v",
    "dir::../../verilog/rtl/aes_key_expansion.v",
    "dir::../../verilog/rtl/aes_round.v",
    "dir::../../verilog/rtl/aes128_core.v"
  ],

  "IGNORE_DISCONNECTED_MODULES": [
    "Neuromorphic_X1_wb"
  ],

  "DESIGN_NAME": "user_project_wrapper",

  "//": "Clock / Timing",
  "CLOCK_PORT": "wb_clk_i",
  "CLOCK_PERIOD": 25,
  "PNR_SDC_FILE": "dir::signoff.sdc",
  "SIGNOFF_SDC_FILE": "dir::signoff.sdc",
  "CLOCK_UNCERTAINTY_CONSTRAINT": 0.25,
  "TIME_DERATING_CONSTRAINT": 0.05,
  "MAX_TRANSITION_CONSTRAINT": 1.5,
  "MAX_FANOUT_CONSTRAINT": 4,

  "//": "Floorplan",
  "FP_SIZING": "absolute",
  "DIE_AREA": [0, 0, 2920, 3520],
  "FP_DEF_TEMPLATE": "dir::fixed_dont_change/user_project_wrapper.def",
  "FP_PPL_MODE": "matching",
  "PL_TARGET_DENSITY_PCT": 18,
  "PL_ROUTABILITY_DRIVEN": true,
  "PL_TIME_DRIVEN": false,
  "GPL_CELL_PADDING": 3,

  "//": "Power Nets",
  "VDD_NETS": [
    "vccd1",
    "vdda1",
    "vccd2",
    "vdda2"
  ],

  "GND_NETS": [
    "vssd1",
    "vssa1",
    "vssd2",
    "vssa2"
  ],

  "//": "PDN",
  "FP_PDN_ENABLE_RAILS": true,
  "FP_PDN_MULTILAYER": true,
  "FP_PDN_VERTICAL_LAYER": "met4",
  "FP_PDN_HORIZONTAL_LAYER": "met5",
  "FP_PDN_VPITCH": 180,
  "FP_PDN_HPITCH": 180,
  "FP_PDN_VOFFSET": 16.65,
  "FP_PDN_HOFFSET": 16.65,
  "FP_PDN_VWIDTH": 3.1,
  "FP_PDN_HWIDTH": 3.1,
  "FP_PDN_CORE_RING": false,
  "ERROR_ON_PDN_VIOLATIONS": false,

  "//": "Routing / Placement",
  "RUN_CTS": true,
  "RUN_FILL_INSERTION": true,
  "RUN_TAP_ENDCAP_INSERTION": true,
  "RUN_IRDROP_REPORT": false,
  "RUN_POST_GPL_DESIGN_REPAIR": true,
  "RUN_POST_CTS_RESIZER_TIMING": true,
  "DESIGN_REPAIR_BUFFER_INPUT_PORTS": true,

  "GRT_ALLOW_CONGESTION": true,
  "GRT_OVERFLOW_ITERS": 400,
  "RT_MAX_LAYER": "met4",
  "DRT_OPT_ITERS": 64,

  "//": "Antenna Repair",
  "RUN_ANTENNA_REPAIR": true,
  "RUN_HEURISTIC_DIODE_INSERTION": true,
  "HEURISTIC_ANTENNA_THRESHOLD": 40,
  "GRT_ANTENNA_ITERS": 25,
  "GRT_ANTENNA_MARGIN": 2,
  "DIODE_PADDING": 3,

  "//": "Design Repair",
  "DESIGN_REPAIR_MAX_SLEW_PCT": 10,
  "DESIGN_REPAIR_MAX_CAP_PCT": 10,
  "CTS_MAX_CAP": 0.25,
  "//": "CTS",
  "CTS_CLK_BUFFERS": [
    "sky130_fd_sc_hd__clkbuf_2",
    "sky130_fd_sc_hd__clkbuf_4",
    "sky130_fd_sc_hd__clkbuf_8"
  ],

  "//": "Synthesis",
  "VERILOG_POWER_DEFINE": "USE_POWER_PINS",
  "ERROR_ON_SYNTH_CHECKS": false,
  "SYNTH_CHECKS_ALLOW_TRISTATE": true,

  "//": "Magic / DRC",
  "MAGIC_EXT_USE_GDS": true,
  "MAGIC_DRC_USE_GDS": true,
  "MAGIC_CAPTURE_ERRORS": false,
  "ERROR_ON_MAGIC_DRC": false,
  "MAGIC_DEF_LABELS": false,
  "MAGIC_ZEROIZE_ORIGIN": false,
  "RUN_KLAYOUT_DRC": false,

  "//": "Threads",
  "DRT_THREADS": 1,

  "meta": {
    "version": 2
  }
}
